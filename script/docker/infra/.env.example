TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
BLADE_MYSQL_PASSWORD=replace-with-strong-blade-password
NACOS_MYSQL_PASSWORD=replace-with-strong-nacos-password
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

NACOS_AUTH_IDENTITY_KEY=replace-with-random-identity-key
NACOS_AUTH_IDENTITY_VALUE=replace-with-random-identity-value
NACOS_AUTH_TOKEN=replace-with-base64-secret-at-least-32-bytes
NACOS_BIND_ADDRESS=127.0.0.1
NACOS_SERVER_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=8080

SENTINEL_BIND_ADDRESS=127.0.0.1
SENTINEL_PORT=8858
