REGISTRY=ghcr.io
IMAGE_NAMESPACE=replace-with-lowercase-github-owner
IMAGE_TAG=replace-with-git-sha

TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8

BLADE_NACOS_ADDR=nacos:8848
BLADE_NACOS_NAMESPACE=prod
BLADE_NACOS_USERNAME=nacos
BLADE_NACOS_PASSWORD=replace-me
BLADE_SENTINEL_ADDR=sentinel:8858

BLADE_DATASOURCE_URL=jdbc:mysql://mysql:3306/blade?useSSL=false&useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=convertToNull&transformedBitIsBoolean=true&tinyInt1isBit=false&allowMultiQueries=true&serverTimezone=GMT%2B8
BLADE_DATASOURCE_USERNAME=blade
BLADE_DATASOURCE_PASSWORD=replace-me

BLADE_REDIS_HOST=redis
BLADE_REDIS_PORT=6379
BLADE_REDIS_PASSWORD=replace-me
BLADE_REDIS_DATABASE=0


BLADE_AI_REVERSE_FAST_BASE_URL=
BLADE_AI_REVERSE_FAST_API_KEY=
BLADE_AI_REVERSE_TARGET_ENGINE=

GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_LIVENESS_URL=http://127.0.0.1:8080/
GATEWAY_LIVENESS_RETRIES=30
GATEWAY_LIVENESS_INTERVAL_SECONDS=10

# 新认证单一入口；以下项在仓库外受控配置填入，不提交真实值。
AUTHORIZATION_ISSUER=
AUTHORIZATION_FRONTEND_BASE_URI=
AUTHORIZATION_BFF_LOGIN_URI=
AUTHORIZATION_REDIRECT_URI=
BFF_FRONTEND_URI=
AUTHORIZATION_CLIENT_ID=gateway-bff
AUTHORIZATION_CLIENT_SECRET=
AUTHORIZATION_INTERNAL_CLIENT_SECRET=
AUTHORIZATION_PAYLOAD_ENCRYPTION_KEY=
AUTHORIZATION_ACTIVE_KEY_ID=
AUTHORIZATION_JWK_FILE=
AUTHORIZATION_DATASOURCE_URL=
AUTHORIZATION_DATASOURCE_USERNAME=
AUTHORIZATION_DATASOURCE_PASSWORD=
AUTHORIZATION_TRUSTED_PROXY_PATTERN=
AUTHORIZATION_SYSTEM_CLIENT_SECRET=
AUTHORIZATION_DESK_CLIENT_SECRET=
AUTHORIZATION_LOG_CLIENT_SECRET=
AUTHORIZATION_RESOURCE_CLIENT_SECRET=
AUTHORIZATION_DEVELOP_CLIENT_SECRET=
AUTHORIZATION_REPORT_CLIENT_SECRET=
AUTHORIZATION_AI_CLIENT_SECRET=
AUTHORIZATION_ADMIN_CLIENT_SECRET=
