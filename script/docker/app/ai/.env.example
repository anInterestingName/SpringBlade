REGISTRY=ghcr.io
IMAGE_NAMESPACE=replace-with-lowercase-github-owner
IMAGE_TAG=replace-with-12-character-git-sha

TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:MaxDirectMemorySize=128m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=96m -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

BLADE_NACOS_ADDR=replace-with-shanghai-public-ip:8848
BLADE_NACOS_NAMESPACE=prod
BLADE_NACOS_USERNAME=replace-with-nacos-username
BLADE_NACOS_PASSWORD=replace-with-nacos-password
BLADE_SENTINEL_ADDR=replace-with-shanghai-public-ip:8858

BLADE_REDIS_HOST=replace-with-shanghai-public-ip
BLADE_REDIS_PORT=6379
BLADE_REDIS_PASSWORD=replace-with-redis-password
BLADE_REDIS_DATABASE=0

BLADE_DATASOURCE_URL=jdbc:mysql://replace-with-shanghai-public-ip:3306/blade?useSSL=false&useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
BLADE_DATASOURCE_USERNAME=replace-with-blade-db-username
BLADE_DATASOURCE_PASSWORD=replace-with-blade-db-password
BLADE_TOKEN_SIGN_KEY=replace-with-at-least-32-characters
BLADE_TOKEN_CRYPTO_KEY=replace-with-valid-aes-key

BLADE_AI_REVERSE_FAST_BASE_URL=replace-with-fast-service-url
BLADE_AI_REVERSE_FAST_API_KEY=replace-with-fast-service-api-key
BLADE_AI_REVERSE_TARGET_ENGINE=replace-with-target-engine

DISCOVERY_IP=replace-with-silicon-valley-public-ip
DISCOVERY_PORT=8107
AI_BIND_ADDRESS=0.0.0.0
AI_PORT=8107
AI_MEMORY_LIMIT=896m
AI_MEMORY_RESERVATION=640m
AI_CPUS=1.0
