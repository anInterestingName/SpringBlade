REGISTRY=ghcr.io
IMAGE_NAMESPACE=replace-with-lowercase-github-owner
IMAGE_TAG=replace-with-12-character-git-sha

TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-Xms128m -Xmx256m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:MaxDirectMemorySize=128m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=96m -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

BLADE_NACOS_ADDR=replace-with-shanghai-public-ip:8848
BLADE_NACOS_NAMESPACE=prod
BLADE_NACOS_USERNAME=nacos
BLADE_NACOS_PASSWORD=replace-me

BLADE_SENTINEL_ADDR=replace-with-shanghai-public-ip:8858

BLADE_REDIS_HOST=<上海公网IP>
BLADE_REDIS_PORT=6379
BLADE_REDIS_PASSWORD=replace-me
BLADE_REDIS_DATABASE=0

BLADE_TOKEN_SIGN_KEY=replace-with-at-least-32-characters
BLADE_TOKEN_CRYPTO_KEY=replace-with-valid-aes-key

DISCOVERY_IP=replace-with-shanghai-public-ip
DISCOVERY_PORT=80
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_MEMORY_LIMIT=640m
GATEWAY_MEMORY_RESERVATION=384m
GATEWAY_CPUS=1.0
