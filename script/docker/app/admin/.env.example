REGISTRY=ghcr.io
IMAGE_NAMESPACE=replace-with-lowercase-github-owner
IMAGE_TAG=replace-with-12-character-git-sha

TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod
JAVA_TOOL_OPTIONS=-Xms128m -Xmx256m -Xss512k -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:MaxDirectMemorySize=64m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=96m -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

BLADE_NACOS_ADDR=replace-with-shanghai-public-ip:8848
BLADE_NACOS_NAMESPACE=prod
BLADE_NACOS_USERNAME=replace-with-nacos-username
BLADE_NACOS_PASSWORD=replace-with-nacos-password
BLADE_SENTINEL_ADDR=replace-with-shanghai-public-ip:8858

DISCOVERY_IP=replace-with-silicon-valley-public-ip
DISCOVERY_PORT=7002
ADMIN_BIND_ADDRESS=0.0.0.0
ADMIN_PORT=7002
ADMIN_MEMORY_LIMIT=512m
ADMIN_MEMORY_RESERVATION=384m
ADMIN_CPUS=0.5
